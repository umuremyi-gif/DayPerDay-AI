# Ollama Configuration
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60

# Backend Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=*

# Scheduler (set to "true" to enable background jobs)
ENABLE_SCHEDULER=true

# ==================== Translation / Multilingual AI ====================
# Provider: "ollama" (default, free, local), "deepl" (requires API key), "google" (requires API key)
TRANSLATION_PROVIDER=ollama
TRANSLATION_TIMEOUT=30
TRANSLATION_RETRIES=2

# DeepL API (optional — paid service)
# Free tier: 500,000 characters/month. Pro: from $5.49/month for 1M chars.
# Sign up at https://www.deepl.com/pro-api
# DEEPL_API_KEY=
# DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate

# Google Cloud Translation API (optional — paid service)
# Basic edition: $20 per 1M characters. Sign up at https://cloud.google.com/translate
# GOOGLE_TRANSLATE_API_KEY=
